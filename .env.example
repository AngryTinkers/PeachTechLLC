# Copy to .env.local and fill in. Restart `npm run dev` / rebuild after changes.

# ── Site ───────────────────────────────────────────────
# Public production URL (used for canonical URLs, sitemap, structured data)
SITE_URL=https://peachtech.dev
COMPANY_FOUNDING_YEAR=2024

# ── Contact info (shown in footer, contact page, structured data) ──
CONTACT_EMAIL=hello@peachtech.dev
CAREERS_EMAIL=careers@peachtech.dev
CONTACT_PHONE=+1 (555) 010-2024
CONTACT_HOURS=Mon – Fri, 9:00 – 18:00

# Optional postal address (leave blank to hide)
COMPANY_STREET=
COMPANY_CITY=
COMPANY_REGION=
COMPANY_POSTAL_CODE=
COMPANY_COUNTRY=US

# Optional social profiles (leave blank to hide)
SOCIAL_LINKEDIN=
SOCIAL_GITHUB=
SOCIAL_X=

# ── Job application email (SMTP) ───────────────────────
# Any SMTP provider works: Gmail (app password), Google Workspace, SendGrid,
# Mailgun, Amazon SES, Resend SMTP, Postmark, etc.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# "true" for port 465 (implicit TLS); leave blank to auto-detect from port
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Sender shown on emails, e.g. "PeachTech Careers <careers@peachtech.dev>"
MAIL_FROM=
# Where applications are delivered (defaults to CAREERS_EMAIL)
APPLY_TO_EMAIL=
# "true" to also send the applicant an acknowledgement email
APPLY_SEND_CONFIRMATION=false
